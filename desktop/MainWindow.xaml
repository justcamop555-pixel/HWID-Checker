<Window x:Class="HwidDesktop.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Style="{StaticResource {x:Type Window}}" Title="HWID Checker — Desktop" Icon="assets/Hwid.ico"
        Width="1260" Height="850" MinWidth="640" MinHeight="480" WindowStartupLocation="CenterScreen" Closing="OnWindowClosing">
    <Grid x:Name="Dashboard" Background="{DynamicResource CanvasBrush}" UseLayoutRounding="True">
        <Grid.ColumnDefinitions>
            <ColumnDefinition x:Name="SidebarColumn" Width="212"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>
        <Border Background="{DynamicResource SidebarBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,0,1,0">
            <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                <StackPanel Margin="12,18,12,16">
                    <DockPanel Margin="3,0,0,23">
                        <Border Width="32" Height="32" Background="{DynamicResource NavActiveBrush}" CornerRadius="0" Margin="0,0,8,0">
                            <TextBlock Text="H" FontSize="20" FontWeight="Bold" Foreground="{DynamicResource AccentBrush}"
                                       HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock x:Name="BrandText" Text="HWID Checker" FontSize="14" FontWeight="SemiBold" Style="{StaticResource TrimmedText}"/>
                            <TextBlock Text="DESKTOP" Style="{StaticResource Eyebrow}"/>
                        </StackPanel>
                    </DockPanel>
                    <TextBlock Text="INVENTORY" Style="{StaticResource Eyebrow}" Margin="8,0,0,5"/>
                    <Button x:Name="OverviewNav" Style="{StaticResource NavButton}" Tag="Overview" Click="OnNavigate" Content="Overview"/>
                    <Button x:Name="IdentifiersNav" Style="{StaticResource NavButton}" Tag="Identifiers" Click="OnNavigate" Content="IDs &amp; serials"/>
                    <Button x:Name="HardwareNav" Style="{StaticResource NavButton}" Tag="Hardware" Click="OnNavigate" Content="Hardware"/>
                    <Button x:Name="ReviewNav" Style="{StaticResource NavButton}" Tag="Review" Click="OnNavigate" Content="Review"/>
                    <TextBlock Text="SNAPSHOTS" Style="{StaticResource Eyebrow}" Margin="8,18,0,5"/>
                    <Button x:Name="SnapshotsNav" Style="{StaticResource NavButton}" Tag="Snapshots" Click="OnNavigate" Content="Snapshots"/>
                    <Button x:Name="CompareNav" Style="{StaticResource NavButton}" Tag="Compare" Click="OnNavigate" Content="Compare IDs"/>
                    <Border BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,1,0,0" Margin="0,18,0,0" Padding="0,12,0,0">
                        <StackPanel>
                            <Button x:Name="OpenConsoleButton" Content="Open BAT console" Click="OnOpenConsole" FontSize="13" Style="{StaticResource SidebarActionButton}" HorizontalContentAlignment="Left" Padding="8,8" Margin="0,0,0,9"
                                    ToolTip="Open the console. Missing or invalid scanner files fall back to the bundled offline copy."/>
                            <TextBlock x:Name="EngineConnectionText" Text="Connecting to BAT…" FontSize="13" FontWeight="SemiBold"
                                       Foreground="{DynamicResource AccentBrush}" Style="{StaticResource TrimmedText}"/>
                            <TextBlock x:Name="EngineVersionText" Text="Existing PowerShell scanner" FontSize="13" Foreground="{DynamicResource MutedBrush}"
                                       Style="{StaticResource TrimmedText}" Margin="0,3,0,0"/>
                            <TextBlock x:Name="SideVersionText" Text="Desktop" FontSize="13" Foreground="{DynamicResource MutedBrush}" Margin="0,9,0,0"/>
                            <Button x:Name="ThemeButton" Content="Theme: Midnight" Click="OnToggleTheme" FontSize="13" Style="{StaticResource SidebarActionButton}"
                                    HorizontalContentAlignment="Left" Padding="8,6" Margin="0,6,0,0"/>
                            <Button x:Name="RestartButton" Content="Restart app" Click="OnRestartApp" FontSize="13" Style="{StaticResource SidebarActionButton}"
                                    HorizontalContentAlignment="Left" Padding="8,6" Margin="0,6,0,0"/>
                            <Button x:Name="WelcomeButton" Content="Welcome &amp; privacy" Click="OnOpenWelcome" FontSize="13" Style="{StaticResource SidebarActionButton}"
                                    HorizontalContentAlignment="Left" Padding="8,6" Margin="0,6,0,0"/>
                            <Button x:Name="UpdatesButton" Content="Updates…" Click="OnOpenUpdates" FontSize="13" Style="{StaticResource SidebarActionButton}"
                                    HorizontalContentAlignment="Left" Padding="8,6" Margin="0,6,0,0"/>
                            <Button x:Name="MaintenanceButton" Content="Setup &amp; repair…" Click="OnMaintenance" FontSize="13" Style="{StaticResource SidebarActionButton}"
                                    HorizontalContentAlignment="Left" Padding="8,6" Margin="0,6,0,0"/>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </ScrollViewer>
        </Border>

        <Grid x:Name="Workspace" Grid.Column="1" Margin="24,20,24,12">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>
            <Grid x:Name="HeaderPanel" Margin="0,0,0,12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                <StackPanel x:Name="HeaderText" Margin="0,0,14,0">
                    <TextBlock x:Name="PageTitle" Text="Overview" FontSize="28" FontWeight="SemiBold" TextWrapping="Wrap"/>
                    <TextBlock x:Name="PageSubtitle" Text="A clear view of the identifiers Windows reports." Foreground="{DynamicResource MutedBrush}"
                               TextWrapping="Wrap" Margin="0,3,0,0"/>
                </StackPanel>
                <WrapPanel x:Name="HeaderActions" Grid.Column="1" VerticalAlignment="Center">
                    <Button x:Name="ScanButton" Content="Scan this PC" IsEnabled="False" Style="{StaticResource PrimaryButton}" Click="OnScan" MinWidth="108" Margin="0,0,8,0"/>
                    <Button x:Name="SaveButton" Content="Save snapshot" Click="OnSave" Margin="0,0,8,0" IsEnabled="False"/>
                    <Button x:Name="ExportButton" Content="Export CSV / HTML…" Click="OnExportSnapshot" Margin="0,0,8,0" IsEnabled="False"/>
                    <Button x:Name="ConnectButton" Content="Connect BAT…" Click="OnChooseBat" FontSize="13"/>
                </WrapPanel>
            </Grid>
            <Border x:Name="StatusPanel" Grid.Row="1" Background="{DynamicResource StatusBrush}" BorderBrush="{DynamicResource StatusBorderBrush}"
                    BorderThickness="1" CornerRadius="0" Padding="11,8" Margin="0,0,0,13">
                <Grid>
                    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                    <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                    <StackPanel Margin="0,0,8,0">
                        <DockPanel>
                        <Border x:Name="StatusBadgeFrame" DockPanel.Dock="Right" BorderBrush="{DynamicResource AccentBrush}" BorderThickness="1" Padding="6,1" Margin="8,0,0,0">
                            <TextBlock x:Name="StatusBadge" Text="READY" FontSize="11" Foreground="{DynamicResource AccentBrush}"/>
                        </Border>
                        <TextBlock x:Name="StatusTitle" Text="Ready when you are" FontWeight="SemiBold" Foreground="{DynamicResource AccentBrush}" Style="{StaticResource TrimmedText}"/>
                        </DockPanel>
                        <TextBlock x:Name="StatusDetail" Text="Start a scan to collect hardware information and available IDs."
                                   Foreground="{DynamicResource MutedBrush}" Style="{StaticResource TrimmedText}" Margin="0,3,0,0"/>
                    </StackPanel>
                    <Button x:Name="CancelButton" Grid.Column="1" Content="Cancel scan" Click="OnCancel" Visibility="Collapsed" VerticalAlignment="Center" Padding="10,6"/>
                    <ProgressBar x:Name="ScanProgress" Grid.Row="1" Grid.ColumnSpan="2" Height="4" Margin="0,8,0,0"
                                 Visibility="{Binding Visibility,ElementName=CancelButton}" Minimum="0" Maximum="100"
                                 Foreground="{DynamicResource AccentBrush}" Background="{DynamicResource BorderBrush}" BorderThickness="0"/>
                </Grid>
            </Border>
            <ScrollViewer x:Name="PageViewport" Grid.Row="2" VerticalScrollBarVisibility="Auto"
                          HorizontalScrollBarVisibility="Disabled" CanContentScroll="False">
            <Grid x:Name="PageHost" ClipToBounds="True" MinHeight="360"
                  Height="{Binding ViewportHeight,ElementName=PageViewport}">

                <ScrollViewer x:Name="OverviewPage" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                    <StackPanel>
                        <TextBlock x:Name="SnapshotContextText" Text="No completed snapshot" Style="{StaticResource TrimmedText}"
                                   Foreground="{DynamicResource MutedBrush}" FontSize="13" Margin="0,0,8,7"/>
                        <Border x:Name="OverviewComputerCard" Style="{StaticResource Card}" Margin="0,0,8,12" Padding="12,10">
                            <Grid x:Name="OverviewComputerGrid">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition x:Name="OverviewComputerColumn" Width="*"/>
                                    <ColumnDefinition x:Name="OverviewCpuColumn" Width="*"/>
                                    <ColumnDefinition x:Name="OverviewWindowsColumn" Width="*"/>
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>
                                <StackPanel x:Name="ComputerSummary" Grid.Column="0" Margin="0,0,14,0">
                                    <TextBlock Text="PC NAME" Style="{StaticResource Eyebrow}"/>
                                    <TextBlock x:Name="ComputerText" Text="No snapshot yet" FontWeight="SemiBold" Margin="0,4,0,0" Style="{StaticResource TrimmedText}"/>
                                    <TextBlock x:Name="PcModelText" Text="Model · no scan yet" Foreground="{DynamicResource MutedBrush}" FontSize="13" Style="{StaticResource TrimmedText}"/>
                                    <TextBlock x:Name="CapturedText" Text="Scan to capture this PC" Foreground="{DynamicResource MutedBrush}" FontSize="13" Style="{StaticResource TrimmedText}"/>
                                </StackPanel>
                                <StackPanel x:Name="CpuSummary" Grid.Column="1" Margin="0,0,14,0">
                                    <TextBlock Text="PROCESSOR" Style="{StaticResource Eyebrow}"/>
                                    <TextBlock x:Name="CpuText" Text="—" Margin="0,4,0,0" Style="{StaticResource TrimmedText}"/>
                                    <TextBlock x:Name="MemoryText" Text="Memory —" Foreground="{DynamicResource MutedBrush}" FontSize="13" Style="{StaticResource TrimmedText}"/>
                                </StackPanel>
                                <StackPanel x:Name="WindowsSummary" Grid.Column="2">
                                    <TextBlock Text="WINDOWS" Style="{StaticResource Eyebrow}"/>
                                    <TextBlock x:Name="WindowsText" Text="—" Margin="0,4,0,0" Style="{StaticResource TrimmedText}"/>
                                    <TextBlock x:Name="CatalogText" Text="Catalog waiting for a scan" Foreground="{DynamicResource MutedBrush}" FontSize="13" Style="{StaticResource TrimmedText}"/>
                                </StackPanel>
                            </Grid>
                        </Border>
                        <UniformGrid x:Name="MetricsGrid" Columns="4" Margin="0,0,0,4">
                            <Border Style="{StaticResource Card}" Margin="0,0,8,8" Padding="12,9">
                                <StackPanel>
                                    <TextBlock Text="IDENTIFIER FIELDS" Style="{StaticResource Eyebrow}"/>
                                    <TextBlock x:Name="IdsCount" Text="—" FontSize="26" FontWeight="SemiBold" Foreground="{DynamicResource AccentBrush}"/>
                                    <TextBlock Text="Reported by Windows" Foreground="{DynamicResource MutedBrush}" FontSize="13" TextWrapping="Wrap"/>
                                </StackPanel>
                            </Border>
                            <Border Style="{StaticResource Card}" Margin="0,0,8,8" Padding="12,9">
                                <StackPanel>
                                    <TextBlock Text="SECTIONS READ" Style="{StaticResource Eyebrow}"/>
                                    <TextBlock x:Name="SectionsCount" Text="— / 18" FontSize="26" FontWeight="SemiBold"/>
                                    <TextBlock Text="Hardware and system" Foreground="{DynamicResource MutedBrush}" FontSize="13" TextWrapping="Wrap"/>
                                </StackPanel>
                            </Border>
                            <Border Style="{StaticResource Card}" Margin="0,0,8,8" Padding="12,9">
                                <StackPanel>
                                    <TextBlock Text="REVIEW FINDINGS" Style="{StaticResource Eyebrow}"/>
                                    <TextBlock x:Name="ReviewCount" Text="—" FontSize="26" FontWeight="SemiBold" Foreground="{DynamicResource WarningBrush}"/>
                                    <TextBlock Text="Missing IDs and conflicts" Foreground="{DynamicResource MutedBrush}" FontSize="13" TextWrapping="Wrap"/>
                                </StackPanel>
                            </Border>
                            <Border Style="{StaticResource Card}" Margin="0,0,8,8" Padding="12,9">
                                <StackPanel>
                                    <TextBlock Text="DEVICE RECORDS" Style="{StaticResource Eyebrow}"/>
                                    <TextBlock x:Name="DevicesCount" Text="—" FontSize="26" FontWeight="SemiBold"/>
                                    <TextBlock Text="Windows device catalog" Foreground="{DynamicResource MutedBrush}" FontSize="13" TextWrapping="Wrap"/>
                                </StackPanel>
                            </Border>
                        </UniformGrid>
                        <Border Style="{StaticResource Card}" Margin="0,0,8,0" Padding="0">
                            <StackPanel>
                                <Grid x:Name="ScanActivityHeader" Margin="12,10">
                                    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                    <TextBlock Text="Scan activity" FontSize="16" FontWeight="SemiBold"/>
                                    <TextBlock x:Name="ScanElapsedText" Grid.Column="1" Text="18 sections + device catalog"
                                               Foreground="{DynamicResource MutedBrush}" FontSize="13" TextAlignment="Right"
                                               VerticalAlignment="Center" Style="{StaticResource TrimmedText}"/>
                                </Grid>
                                <WrapPanel Margin="12,0,12,8">
                                    <TextBlock Text="READ · data received" Foreground="{DynamicResource SuccessBrush}" FontSize="12" Margin="0,0,16,0"/>
                                    <TextBlock Text="CHECK · review values" Foreground="{DynamicResource WarningBrush}" FontSize="12" Margin="0,0,16,0"/>
                                    <TextBlock Text="NOT READ · read failed" Foreground="{DynamicResource ErrorBrush}" FontSize="12"/>
                                </WrapPanel>
                                <DataGrid x:Name="ScanGrid" ItemsSource="{Binding ScanRows}" Style="{StaticResource PageGrid}"
                                          ScrollViewer.VerticalScrollBarVisibility="Disabled" AutomationProperties.Name="Scan activity"
                                          AutomationProperties.HelpText="Shows each section's status, returned records and elapsed time. Waiting and reading rows have not finished.">
                                    <DataGrid.Columns>
                                        <DataGridTextColumn Header="Section" Binding="{Binding Name}" Width="1.5*" MinWidth="110" ElementStyle="{StaticResource CellText}"/>
                                        <DataGridTextColumn Header="Status" Binding="{Binding Status}" Width="120" MinWidth="120" ElementStyle="{StaticResource StatusText}"/>
                                        <DataGridTextColumn Header="Records" Binding="{Binding Records}" Width="65" ElementStyle="{StaticResource CellText}"/>
                                        <DataGridTextColumn Header="Read details" Binding="{Binding Detail}" Width="2*" MinWidth="91" ElementStyle="{StaticResource CellText}"/>
                                        <DataGridTextColumn Header="Time" Binding="{Binding Time}" Width="62" ElementStyle="{StaticResource CellText}"/>
                                    </DataGrid.Columns>
                                </DataGrid>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </ScrollViewer>

                <Grid x:Name="IdentifiersPage" Visibility="Collapsed">
                    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition x:Name="IdDetailRow" Height="0.42*" MinHeight="70" MaxHeight="126"/></Grid.RowDefinitions>
                    <StackPanel x:Name="IdToolsPanel" Margin="0,0,0,10">
                    <Grid x:Name="IdToolbar">
                        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                        <Grid x:Name="IdSearchPanel">
                            <TextBox x:Name="IdSearch" TextChanged="OnIdFilterChanged" AutomationProperties.Name="Search identifiers"
                                     VerticalContentAlignment="Center" ToolTip="Search by section, device, field, value or status"/>
                            <TextBlock Text="Search IDs…" IsHitTestVisible="False" Margin="10,0" VerticalAlignment="Center" Foreground="{DynamicResource MutedBrush}">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Visibility" Value="Collapsed"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding Text,ElementName=IdSearch}" Value="">
                                                <Setter Property="Visibility" Value="Visible"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                        </Grid>
                        <ComboBox x:Name="IdFilter" Grid.Column="1" Width="120" Margin="8,0" SelectionChanged="OnIdFilterChanged" AutomationProperties.Name="Filter identifiers">
                            <ComboBoxItem Content="All ID fields" IsSelected="True"/>
                            <ComboBoxItem Content="Reported"/>
                            <ComboBoxItem Content="Needs review"/>
                        </ComboBox>
                        <Button x:Name="CopyIdButton" Grid.Column="2" Content="Copy value" Click="OnCopyId" IsEnabled="False"/>
                        <Button x:Name="CopyIdsButton" Grid.Column="3" Content="Copy listed rows" Click="OnCopyAllIds" IsEnabled="False" Margin="8,0,0,0" ToolTip="Copy the listed fields with their device names, values and status"/>
                    </Grid>
                    <TextBlock x:Name="IdResultsText" Text="Scan this PC to view identifiers." TextWrapping="Wrap"
                               Foreground="{DynamicResource MutedBrush}" Margin="0,6,0,0"/>
                    </StackPanel>
                    <Border Grid.Row="1" Style="{StaticResource Card}" Padding="0">
                        <Grid>
                        <DataGrid x:Name="IdentifiersGrid" Style="{StaticResource PageGrid}" SelectionChanged="OnIdSelected" MouseDoubleClick="OnIdDoubleClicked" PreviewKeyDown="OnDetailsKeyDown" ToolTip="Select a row to read it. Double-click or press Enter for full details. Copy value copies the original identifier.">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="Section" Binding="{Binding Section}" Width="*" MinWidth="86" ElementStyle="{StaticResource CellText}"/>
                                <DataGridTextColumn x:Name="IdDeviceColumn" Header="Device" Binding="{Binding Device}" Width="1.25*" MinWidth="110" ElementStyle="{StaticResource CellText}"/>
                                <DataGridTextColumn Header="Identifier" Binding="{Binding Field}" Width="1.15*" MinWidth="88" ElementStyle="{StaticResource CellText}"/>
                                <DataGridTextColumn Header="Value" Binding="{Binding Value}" Width="2*" MinWidth="98" ElementStyle="{StaticResource CellText}"/>
                                <DataGridTextColumn Header="Status" Binding="{Binding Status}" Width="82" ElementStyle="{StaticResource StatusText}"/>
                            </DataGrid.Columns>
                        </DataGrid>
                        <TextBlock x:Name="IdEmptyText" Text="Scan this PC to view identifiers." TextWrapping="Wrap" Margin="16"
                                   VerticalAlignment="Center" HorizontalAlignment="Center" Foreground="{DynamicResource MutedBrush}"/>
                        </Grid>
                    </Border>
                    <DockPanel Grid.Row="2" Margin="0,8,0,0">
                        <TextBlock x:Name="IdDetailLabel" DockPanel.Dock="Top" Text="SELECTED VALUE · Enter on a row opens details" TextWrapping="Wrap" Style="{StaticResource Eyebrow}" Margin="0,0,0,4"/>
                        <TextBox x:Name="IdDetail" Style="{StaticResource DetailBox}" FontFamily="Consolas" AutomationProperties.Name="Selected identifier value"/>
                    </DockPanel>
                </Grid>

                <Grid x:Name="HardwarePage" Visibility="Collapsed">
                    <Grid.ColumnDefinitions><ColumnDefinition x:Name="HardwareSectionsColumn" Width="210"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                    <Border x:Name="HardwareSectionsPanel" Style="{StaticResource Card}" Padding="4" Margin="0,0,10,0">
                        <ListBox x:Name="HardwareSections" SelectionChanged="OnHardwareSectionSelected" AutomationProperties.Name="Hardware section">
                            <ListBox.ItemContainerStyle>
                                <Style TargetType="ListBoxItem" BasedOn="{StaticResource {x:Type ListBoxItem}}">
                                    <Setter Property="Padding" Value="8,7"/>
                                    <Setter Property="AutomationProperties.Name" Value="{Binding Display}"/>
                                    <Setter Property="ToolTip" Value="{Binding Display}"/>
                                </Style>
                            </ListBox.ItemContainerStyle>
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <StackPanel>
                                        <TextBlock Text="{Binding FriendlyName}" TextWrapping="Wrap" LineHeight="19" FontSize="14"/>
                                        <TextBlock Text="{Binding CountText}" Foreground="{DynamicResource MutedBrush}" FontSize="13" Margin="0,2,0,0"/>
                                    </StackPanel>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                    </Border>
                    <Grid Grid.Column="1">
                        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition x:Name="HardwareDetailRow" Height="0.42*" MinHeight="66" MaxHeight="136"/></Grid.RowDefinitions>
                        <Grid Margin="0,0,0,10">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                            <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                            <TextBlock x:Name="HardwareSectionTitle" Grid.ColumnSpan="3" Text="Hardware fields" FontSize="17" FontWeight="SemiBold"
                                       Margin="0,0,0,6" Style="{StaticResource TrimmedText}"/>
                            <Grid x:Name="HardwareSearchHost" Grid.Row="1" Grid.ColumnSpan="3" Margin="0,0,0,8">
                                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                <Grid>
                                <TextBox x:Name="HardwareSearch" TextChanged="OnHardwareFilterChanged" AutomationProperties.Name="Search hardware records"
                                         VerticalContentAlignment="Center" ToolTip="Filter records in this section by any field"/>
                                <TextBlock Text="Search records…" IsHitTestVisible="False" Margin="10,0" VerticalAlignment="Center" Foreground="{DynamicResource MutedBrush}">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="Visibility" Value="Collapsed"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding Text,ElementName=HardwareSearch}" Value="">
                                                    <Setter Property="Visibility" Value="Visible"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                                </Grid>
                                <TextBlock x:Name="HardwareCountText" Grid.Column="1" Text="No records" Style="{StaticResource TrimmedText}"
                                           Foreground="{DynamicResource MutedBrush}" FontSize="13" Margin="10,0,0,0" VerticalAlignment="Center"/>
                            </Grid>
                            <ComboBox x:Name="HardwareSectionPicker" Grid.Row="2" Visibility="Collapsed" Margin="0,0,8,0"
                                      DisplayMemberPath="FriendlyName" ItemsSource="{Binding ItemsSource,ElementName=HardwareSections}"
                                      SelectedItem="{Binding SelectedItem,ElementName=HardwareSections,Mode=TwoWay}" AutomationProperties.Name="Hardware section"/>
                            <ComboBox x:Name="HardwareRecord" Grid.Row="2" Grid.ColumnSpan="2" DisplayMemberPath="Title"
                                      SelectionChanged="OnHardwareRecordSelected" AutomationProperties.Name="Hardware record"/>
                            <Button x:Name="CopyHardwareButton" Grid.Row="2" Grid.Column="2" Content="Copy value" Click="OnCopyField" Margin="8,0,0,0" IsEnabled="False"
                                    ToolTip="Copy the original value supplied by Windows, including the full identifier or timestamp."/>
                        </Grid>
                        <Border Grid.Row="1" Style="{StaticResource Card}" Padding="0">
                            <Grid>
                            <DataGrid x:Name="HardwareFields" Style="{StaticResource PageGrid}" SelectionChanged="OnHardwareFieldSelected" MouseDoubleClick="OnDetailsDoubleClick" PreviewKeyDown="OnDetailsKeyDown" ToolTip="Double-click a field or press Enter for full details.">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="Field" Binding="{Binding Field}" Width="*" MinWidth="92" ElementStyle="{StaticResource CellText}"/>
                                    <DataGridTextColumn Header="Windows-reported value" Binding="{Binding Value}" Width="2*" MinWidth="140" ElementStyle="{StaticResource CellText}"/>
                                </DataGrid.Columns>
                            </DataGrid>
                            <ScrollViewer x:Name="HardwareEmptyState" Padding="12,9" HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
                                <StackPanel AutomationProperties.LiveSetting="Polite">
                                    <TextBlock x:Name="HardwareEmptyTitle" Text="Scan this PC to view hardware" Style="{StaticResource EmptyStateTitle}"/>
                                    <TextBlock x:Name="HardwareEmptyText" Text="Captured components and their Windows-reported fields will appear here." Style="{StaticResource EmptyStateText}"/>
                                    <Button x:Name="HardwareEmptyAction" Content="Scan this PC" Tag="Scan" Click="OnEmptyStateAction" HorizontalAlignment="Left" Padding="10,6" Margin="0,10,0,0"/>
                                </StackPanel>
                            </ScrollViewer>
                            </Grid>
                        </Border>
                        <TextBox Grid.Row="2" x:Name="HardwareDetail" Margin="0,8,0,0" Style="{StaticResource DetailBox}"
                                 FontFamily="Consolas" AutomationProperties.Name="Selected hardware field value"/>
                    </Grid>
                </Grid>

                <Grid x:Name="ReviewPage" Visibility="Collapsed">
                    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition x:Name="ReviewDetailRow" Height="0.52*" MinHeight="66" MaxHeight="166"/></Grid.RowDefinitions>
                    <StackPanel Margin="0,0,0,10">
                    <Grid>
                        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                        <Grid>
                            <TextBox x:Name="ReviewSearch" TextChanged="OnReviewFilterChanged" AutomationProperties.Name="Search review findings"
                                     VerticalContentAlignment="Center" ToolTip="Search findings by kind, section, device or message"/>
                            <TextBlock Text="Search findings…" IsHitTestVisible="False" Margin="10,0" VerticalAlignment="Center" Foreground="{DynamicResource MutedBrush}">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Visibility" Value="Collapsed"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding Text,ElementName=ReviewSearch}" Value="">
                                                <Setter Property="Visibility" Value="Visible"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                        </Grid>
                        <ComboBox x:Name="ReviewFilter" Grid.Column="1" Width="140" Margin="8,0,0,0" SelectionChanged="OnReviewKindChanged" AutomationProperties.Name="Filter review type">
                            <ComboBoxItem Content="All findings" IsSelected="True"/>
                            <ComboBoxItem Content="Read errors"/>
                            <ComboBoxItem Content="Missing / default IDs"/>
                            <ComboBoxItem Content="Conflicts"/>
                            <ComboBoxItem Content="Device status"/>
                        </ComboBox>
                    </Grid>
                        <TextBlock x:Name="ReviewResultsText" Text="No scan yet" Style="{StaticResource TrimmedText}"
                                   Foreground="{DynamicResource MutedBrush}" Margin="8,0,0,0" VerticalAlignment="Center"
                                   ToolTip="Missing identifiers can be normal. Review explains the information Windows reported."/>
                    </StackPanel>
                    <Border Grid.Row="1" Style="{StaticResource Card}" Padding="0">
                        <Grid>
                        <DataGrid x:Name="ReviewGrid" Style="{StaticResource PageGrid}" SelectionChanged="OnReviewSelected" MouseDoubleClick="OnDetailsDoubleClick" PreviewKeyDown="OnDetailsKeyDown" ToolTip="Double-click a finding or press Enter for the explanation and next step.">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="Kind" Binding="{Binding Kind}" Width="*" MinWidth="81" ElementStyle="{StaticResource CellText}"/>
                                <DataGridTextColumn Header="Section / device" Binding="{Binding Section}" Width="1.5*" MinWidth="108" ElementStyle="{StaticResource CellText}"/>
                                <DataGridTextColumn Header="Finding" Binding="{Binding Message}" Width="2.6*" MinWidth="110" ElementStyle="{StaticResource CellText}"/>
                            </DataGrid.Columns>
                        </DataGrid>
                        <ScrollViewer x:Name="ReviewEmptyState" Padding="12,9" HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
                            <StackPanel AutomationProperties.LiveSetting="Polite">
                                <TextBlock x:Name="ReviewEmptyTitle" Text="Start a scan to review this PC" Style="{StaticResource EmptyStateTitle}"/>
                                <TextBlock x:Name="ReviewEmptyText" Text="Warnings and unread sections will appear here after a scan." Style="{StaticResource EmptyStateText}"/>
                                <Button x:Name="ReviewEmptyAction" Content="Scan this PC" Tag="Scan" Click="OnEmptyStateAction"
                                        HorizontalAlignment="Left" Padding="10,6" Margin="0,10,0,0"/>
                            </StackPanel>
                        </ScrollViewer>
                        </Grid>
                    </Border>
                    <TextBox x:Name="ReviewDetail" Grid.Row="2" Margin="0,8,0,0" Style="{StaticResource DetailBox}" AutomationProperties.Name="Review finding details"/>
                </Grid>

                <Grid x:Name="SnapshotsPage" Visibility="Collapsed">
                    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                    <StackPanel>
                        <TextBlock x:Name="SnapshotCountText" Text="Looking for JSON snapshots…" Style="{StaticResource TrimmedText}" Margin="0,0,0,4"/>
                        <TextBlock x:Name="SnapshotFoldersText" Style="{StaticResource TrimmedText}"
                                   Foreground="{DynamicResource MutedBrush}" FontSize="13" Margin="0,0,0,6"/>
                        <WrapPanel x:Name="SnapshotToolsPanel">
                            <Button x:Name="SnapshotFolderSettingsButton" Content="Folder settings…" Click="OnSnapshotFolderSettings" Margin="0,0,8,4"/>
                            <Button x:Name="RefreshSnapshotsButton" Content="Refresh list" Click="OnRefreshSnapshots" Margin="0,0,8,4"/>
                            <Button x:Name="CompareSavedButton" Content="Compare two saved…" Click="OnCompareSavedSelected" Margin="0,0,0,4"
                                    ToolTip="Select a previous snapshot below, then choose a second saved JSON. No live scan is required."/>
                        </WrapPanel>
                    </StackPanel>
                    <Grid Grid.Row="1" Margin="0,0,0,8">
                        <TextBox x:Name="SnapshotSearch" TextChanged="OnSnapshotSearchChanged"
                                 AutomationProperties.Name="Search saved snapshots" ToolTip="Search by PC name, capture time, file name or folder"/>
                        <TextBlock Text="Search saved snapshots…" Margin="10,0" VerticalAlignment="Center" IsHitTestVisible="False"
                                   Foreground="{DynamicResource MutedBrush}"><TextBlock.Style>
                            <Style TargetType="TextBlock"><Setter Property="Visibility" Value="Collapsed"/><Style.Triggers>
                                <DataTrigger Binding="{Binding Text,ElementName=SnapshotSearch}" Value=""><Setter Property="Visibility" Value="Visible"/></DataTrigger>
                            </Style.Triggers></Style>
                        </TextBlock.Style></TextBlock>
                    </Grid>
                    <Border Grid.Row="2" Style="{StaticResource Card}" Padding="0">
                        <Grid>
                        <DataGrid x:Name="SnapshotsGrid" Style="{StaticResource PageGrid}" SelectionChanged="OnSnapshotSelected" MouseDoubleClick="OnSnapshotDoubleClick">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="Captured" Binding="{Binding Captured}" Width="1.2*" MinWidth="106" ElementStyle="{StaticResource CellText}"/>
                                <DataGridTextColumn Header="Computer" Binding="{Binding Computer}" Width="*" MinWidth="84" ElementStyle="{StaticResource CellText}"/>
                                <DataGridTextColumn Header="Scanner" Binding="{Binding Version}" Width="76" ElementStyle="{StaticResource CellText}"/>
                                <DataGridTextColumn Header="Snapshot file" Binding="{Binding Name}" Width="1.6*" MinWidth="101" ElementStyle="{StaticResource CellText}"/>
                                <DataGridTextColumn Header="Size" Binding="{Binding Size}" Width="80" ElementStyle="{StaticResource CellText}"/>
                            </DataGrid.Columns>
                        </DataGrid>
                        <ScrollViewer x:Name="SnapshotEmptyState" Background="{DynamicResource PanelBrush}" Padding="12,9" HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
                            <StackPanel AutomationProperties.LiveSetting="Polite">
                                <TextBlock x:Name="SnapshotEmptyTitle" Text="Looking for saved snapshots" Style="{StaticResource EmptyStateTitle}"/>
                                <TextBlock x:Name="SnapshotEmptyText" Text="Checking the shared report folders on this PC." Style="{StaticResource EmptyStateText}"/>
                                <Button x:Name="SnapshotEmptyAction" Content="Scan this PC" Tag="Scan" Click="OnEmptyStateAction" HorizontalAlignment="Left" Padding="10,6" Margin="0,10,0,0"/>
                            </StackPanel>
                        </ScrollViewer>
                        </Grid>
                    </Border>
                    <StackPanel Grid.Row="3" Margin="0,8,0,0">
                        <TextBlock x:Name="SnapshotSelectedPath" Text="Select a previous snapshot, then choose a comparison." Style="{StaticResource TrimmedText}"
                                   Foreground="{DynamicResource MutedBrush}" Margin="0,0,0,5"/>
                        <WrapPanel x:Name="SnapshotFooterActions" HorizontalAlignment="Right">
                            <Button Content="Open folder" Click="OnOpenReports" Margin="0,0,8,0"/>
                            <Button x:Name="CompareSelectedButton" Content="Compare with this scan" Click="OnCompareSelected"
                                    ToolTip="Compare the selected previous snapshot with the completed scan in this window."
                                    Style="{StaticResource PrimaryButton}" IsEnabled="False"/>
                        </WrapPanel>
                    </StackPanel>
                </Grid>

                <Grid x:Name="ComparePage" Visibility="Collapsed">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/>
                        <RowDefinition x:Name="CompareDetailRow" Height="0.5*" MinHeight="72" MaxHeight="155"/>
                    </Grid.RowDefinitions>
                    <Grid x:Name="CompareHeader" Margin="0,0,0,10">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                        <StackPanel x:Name="CompareHeaderText" VerticalAlignment="Center" Margin="0,0,8,0">
                            <TextBlock x:Name="CompareSummaryText" Text="Choose a current scan or two saved captures." Style="{StaticResource TrimmedText}"/>
                            <TextBlock x:Name="CompareBaselineText" Text="Previous: not selected" Foreground="{DynamicResource MutedBrush}"
                                       FontSize="13" Style="{StaticResource TrimmedText}" Margin="0,3,0,0"/>
                            <TextBlock x:Name="CompareCurrentText" Text="Current: not selected" Foreground="{DynamicResource MutedBrush}"
                                       FontSize="13" Style="{StaticResource TrimmedText}" Margin="0,3,0,0"/>
                        </StackPanel>
                        <WrapPanel x:Name="CompareActions" Grid.Column="1" VerticalAlignment="Center" HorizontalAlignment="Right">
                            <Button x:Name="CompareFilesButton" Content="Two saved files…" Click="OnChooseTwoFileComparison" Margin="0,0,8,0"
                                    ToolTip="Compare an older and a newer JSON capture without starting a scan."/>
                            <Button x:Name="CompareExportButton" Content="Export results…" Click="OnExportComparison" Margin="0,0,8,0" IsEnabled="False"
                                    ToolTip="Export the full comparison, including rows hidden by filters."/>
                            <Button x:Name="CompareCurrentButton" Content="Current scan…" Click="OnChooseComparison"
                                    ToolTip="Choose an older JSON capture to compare with the current completed scan."/>
                        </WrapPanel>
                    </Grid>
                    <DockPanel Grid.Row="1" Margin="0,0,0,8">
                        <ComboBox x:Name="CompareFilter" DockPanel.Dock="Right" Width="148" Margin="8,0,0,0"
                                  AutomationProperties.Name="Filter comparison differences" SelectedIndex="0" SelectionChanged="OnCompareFilterChanged">
                            <ComboBoxItem Content="All differences"/><ComboBoxItem Content="Changed values"/>
                            <ComboBoxItem Content="Current only"/><ComboBoxItem Content="Previous only"/>
                        </ComboBox>
                        <Grid>
                            <TextBox x:Name="CompareSearch" TextChanged="OnCompareSearchChanged"
                                     AutomationProperties.Name="Search comparison differences" ToolTip="Search fields, devices, previous values and current values"/>
                            <TextBlock Text="Search differences…" Margin="10,0" VerticalAlignment="Center" IsHitTestVisible="False"
                                       Foreground="{DynamicResource MutedBrush}"><TextBlock.Style>
                                <Style TargetType="TextBlock"><Setter Property="Visibility" Value="Collapsed"/><Style.Triggers>
                                    <DataTrigger Binding="{Binding Text,ElementName=CompareSearch}" Value=""><Setter Property="Visibility" Value="Visible"/></DataTrigger>
                                </Style.Triggers></Style>
                            </TextBlock.Style></TextBlock>
                        </Grid>
                    </DockPanel>
                    <Border Grid.Row="2" Style="{StaticResource Card}" Padding="0">
                        <Grid>
                        <DataGrid x:Name="CompareGrid" Style="{StaticResource PageGrid}" SelectionChanged="OnComparisonSelected" MouseDoubleClick="OnComparisonDoubleClicked">
                            <DataGrid.Columns>
                                <DataGridTemplateColumn Header="Difference" Width="110" SortMemberPath="Kind">
                                    <DataGridTemplateColumn.CellTemplate><DataTemplate>
                                        <TextBlock Text="{Binding Kind}"><TextBlock.Style>
                                            <Style TargetType="TextBlock" BasedOn="{StaticResource CellText}">
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding Kind}" Value="Changed"><Setter Property="Foreground" Value="{DynamicResource WarningBrush}"/></DataTrigger>
                                                    <DataTrigger Binding="{Binding Kind}" Value="Current only"><Setter Property="Foreground" Value="{DynamicResource AccentBrush}"/></DataTrigger>
                                                    <DataTrigger Binding="{Binding Kind}" Value="Previous only"><Setter Property="Foreground" Value="{DynamicResource MutedBrush}"/></DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style></TextBlock>
                                    </DataTemplate></DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                                <DataGridTextColumn Header="Section / field" Binding="{Binding Label}" Width="1.25*" MinWidth="108" ElementStyle="{StaticResource CellText}"/>
                                <DataGridTextColumn Header="Previous value" Binding="{Binding Previous}" Width="*" MinWidth="82" ElementStyle="{StaticResource CellText}"/>
                                <DataGridTextColumn Header="Current value" Binding="{Binding Current}" Width="*" MinWidth="82" ElementStyle="{StaticResource CellText}"/>
                            </DataGrid.Columns>
                        </DataGrid>
                        <ScrollViewer x:Name="CompareEmptyState" Padding="12,9" HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
                            <StackPanel AutomationProperties.LiveSetting="Polite">
                                <TextBlock x:Name="CompareEmptyTitle" Text="Choose what to compare" Style="{StaticResource EmptyStateTitle}"/>
                                <TextBlock x:Name="CompareEmptyText" Text="Start a scan and compare it with an older JSON capture, or choose two saved files." Style="{StaticResource EmptyStateText}"/>
                                <Button x:Name="CompareEmptyAction" Content="Scan this PC" Tag="Scan" Click="OnEmptyStateAction"
                                        HorizontalAlignment="Left" Padding="10,6" Margin="0,10,0,0"/>
                            </StackPanel>
                        </ScrollViewer>
                        </Grid>
                    </Border>
                    <DockPanel x:Name="CompareDetailPanel" Grid.Row="3" Margin="0,8,0,0">
                        <TextBlock x:Name="CompareSkippedText" DockPanel.Dock="Top" Style="{StaticResource TrimmedText}"
                                   FontSize="13" Foreground="{DynamicResource MutedBrush}" Margin="0,0,0,4"/>
                        <TextBox x:Name="CompareDetail" Style="{StaticResource DetailBox}" FontFamily="Consolas" AutomationProperties.Name="Exact identifier difference"/>
                    </DockPanel>
                </Grid>
            </Grid>

            </ScrollViewer>
            <Grid x:Name="FooterPanel" Grid.Row="3" Margin="0,9,0,0">
                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                <TextBlock x:Name="FooterText" Text="Windows-reported inventory" Style="{StaticResource TrimmedText}"
                           Foreground="{DynamicResource MutedBrush}" FontSize="13" Margin="0,0,8,0"/>
                <TextBlock x:Name="PrivacyFooterText" Grid.Column="1" Text="Local scan · review IDs before sharing" Foreground="{DynamicResource MutedBrush}" FontSize="13"
                           ToolTip="Snapshots, exports and clipboard copies contain full identifiers. Update checks contact GitHub. Files in synced folders may be uploaded by that service."/>
            </Grid>
        </Grid>
    </Grid>
</Window>
