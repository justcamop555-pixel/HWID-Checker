<Application x:Class="HwidDesktop.App" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" ShutdownMode="OnMainWindowClose">
 <Application.Resources>
  <SolidColorBrush x:Key="CanvasBrush" Color="#0D1521"/>
  <SolidColorBrush x:Key="SidebarBrush" Color="#101B29"/>
  <SolidColorBrush x:Key="PanelBrush" Color="#152131"/>
  <SolidColorBrush x:Key="BorderBrush" Color="#304258"/>
  <SolidColorBrush x:Key="TextBrush" Color="#EEF5FA"/>
  <SolidColorBrush x:Key="MutedBrush" Color="#A7B9CC"/>
  <SolidColorBrush x:Key="AccentBrush" Color="#66E1CE"/>
  <SolidColorBrush x:Key="WarningBrush" Color="#F3C785"/>
  <SolidColorBrush x:Key="NavActiveBrush" Color="#214642"/>
  <SolidColorBrush x:Key="StatusBrush" Color="#173235"/>
  <SolidColorBrush x:Key="StatusBorderBrush" Color="#36535D"/>
  <SolidColorBrush x:Key="ControlBrush" Color="#1C2B3F"/>
  <SolidColorBrush x:Key="ControlBorderBrush" Color="#405673"/>
  <SolidColorBrush x:Key="ControlHoverBrush" Color="#2B4055"/>
  <SolidColorBrush x:Key="DisabledControlBrush" Color="#202B38"/>
  <SolidColorBrush x:Key="DisabledTextBrush" Color="#9AA9BA"/>
  <SolidColorBrush x:Key="FocusBrush" Color="#BAF6E9"/>

  <Style TargetType="Window">
   <Setter Property="FontFamily" Value="Segoe UI"/>
   <Setter Property="FontSize" Value="13"/>
   <Setter Property="Foreground" Value="{StaticResource TextBrush}"/>
   <Setter Property="Background" Value="{StaticResource CanvasBrush}"/>
   <Setter Property="UseLayoutRounding" Value="True"/>
  </Style>
  <Style TargetType="ToolTip">
   <Setter Property="Foreground" Value="{StaticResource TextBrush}"/>
   <Setter Property="Background" Value="{StaticResource PanelBrush}"/>
   <Setter Property="BorderBrush" Value="{StaticResource ControlBorderBrush}"/>
   <Setter Property="Padding" Value="10,7"/>
   <Setter Property="MaxWidth" Value="500"/>
   <Setter Property="ContentTemplate">
    <Setter.Value>
     <DataTemplate><TextBlock Text="{Binding}" TextWrapping="Wrap"/></DataTemplate>
    </Setter.Value>
   </Setter>
  </Style>
  <Style x:Key="TrimmedText" TargetType="TextBlock">
   <Setter Property="TextWrapping" Value="NoWrap"/>
   <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
   <Setter Property="ToolTip" Value="{Binding Text, RelativeSource={RelativeSource Self}}"/>
   <Setter Property="ToolTipService.ShowOnDisabled" Value="True"/>
  </Style>
  <Style x:Key="Muted" TargetType="TextBlock"><Setter Property="Foreground" Value="{StaticResource MutedBrush}"/><Setter Property="TextWrapping" Value="Wrap"/><Setter Property="LineHeight" Value="20"/></Style>
  <Style x:Key="Eyebrow" TargetType="TextBlock"><Setter Property="TextWrapping" Value="Wrap"/><Setter Property="FontSize" Value="10"/><Setter Property="FontWeight" Value="SemiBold"/><Setter Property="Foreground" Value="{StaticResource MutedBrush}"/></Style>
  <Style x:Key="Card" TargetType="Border"><Setter Property="Background" Value="{StaticResource PanelBrush}"/><Setter Property="BorderBrush" Value="{StaticResource BorderBrush}"/><Setter Property="BorderThickness" Value="1"/><Setter Property="CornerRadius" Value="0"/><Setter Property="Padding" Value="20"/></Style>
  <Style TargetType="Button">
   <Setter Property="Foreground" Value="{StaticResource TextBrush}"/>
   <Setter Property="Background" Value="{StaticResource ControlBrush}"/>
   <Setter Property="BorderBrush" Value="{StaticResource ControlBorderBrush}"/>
   <Setter Property="BorderThickness" Value="1"/>
   <Setter Property="Padding" Value="15,10"/>
   <Setter Property="Cursor" Value="Hand"/>
   <Setter Property="FontWeight" Value="SemiBold"/>
   <Setter Property="HorizontalContentAlignment" Value="Center"/>
   <Setter Property="VerticalContentAlignment" Value="Center"/>
   <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
   <Setter Property="Template">
    <Setter.Value>
     <ControlTemplate TargetType="Button">
      <Border x:Name="Frame" CornerRadius="0" Background="{TemplateBinding Background}"
              BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}">
       <Grid>
        <Border x:Name="Shade" CornerRadius="0" Background="{StaticResource TextBrush}" Opacity="0" IsHitTestVisible="False"/>
        <ContentPresenter x:Name="Label" Margin="{TemplateBinding Padding}" RecognizesAccessKey="True"
                          HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                          VerticalAlignment="{TemplateBinding VerticalContentAlignment}"/>
        <Border x:Name="FocusRing" CornerRadius="0" BorderThickness="2" BorderBrush="{StaticResource FocusBrush}"
                Opacity="0" IsHitTestVisible="False">
         <Border CornerRadius="0" BorderThickness="1" BorderBrush="{StaticResource CanvasBrush}"/>
        </Border>
       </Grid>
      </Border>
      <ControlTemplate.Triggers>
       <Trigger Property="IsMouseOver" Value="True">
        <Setter TargetName="Frame" Property="BorderBrush" Value="{StaticResource AccentBrush}"/>
        <Setter TargetName="Shade" Property="Opacity" Value="0.09"/>
       </Trigger>
       <Trigger Property="IsPressed" Value="True">
        <Setter TargetName="Shade" Property="Background" Value="{StaticResource CanvasBrush}"/>
        <Setter TargetName="Shade" Property="Opacity" Value="0.20"/>
       </Trigger>
       <Trigger Property="IsKeyboardFocused" Value="True">
        <Setter TargetName="FocusRing" Property="Opacity" Value="1"/>
       </Trigger>
       <Trigger Property="IsEnabled" Value="False">
        <Setter Property="Cursor" Value="Arrow"/>
        <Setter TargetName="Frame" Property="Background" Value="{StaticResource DisabledControlBrush}"/>
        <Setter TargetName="Frame" Property="BorderBrush" Value="{StaticResource BorderBrush}"/>
        <Setter TargetName="Label" Property="TextElement.Foreground" Value="{StaticResource DisabledTextBrush}"/>
        <Setter TargetName="Shade" Property="Opacity" Value="0"/>
        <Setter TargetName="FocusRing" Property="Opacity" Value="0"/>
       </Trigger>
      </ControlTemplate.Triggers>
     </ControlTemplate>
    </Setter.Value>
   </Setter>
  </Style>
  <Style x:Key="PrimaryButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}"><Setter Property="Background" Value="{StaticResource AccentBrush}"/><Setter Property="Foreground" Value="#082A2A"/><Setter Property="BorderBrush" Value="{StaticResource AccentBrush}"/></Style>
  <Style x:Key="NavButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
   <Setter Property="Background" Value="Transparent"/>
   <Setter Property="BorderThickness" Value="0"/>
   <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
   <Setter Property="Padding" Value="15,13"/>
   <Setter Property="Margin" Value="0,3"/>
   <Setter Property="Foreground" Value="{StaticResource MutedBrush}"/>
   <Setter Property="ContentTemplate">
    <Setter.Value>
     <DataTemplate><TextBlock Style="{StaticResource TrimmedText}" Text="{Binding}"/></DataTemplate>
    </Setter.Value>
   </Setter>
  </Style>
  <Style TargetType="TextBox">
   <Setter Property="Foreground" Value="{StaticResource TextBrush}"/>
   <Setter Property="Background" Value="{StaticResource CanvasBrush}"/>
   <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}"/>
   <Setter Property="Padding" Value="12,9"/>
   <Setter Property="CaretBrush" Value="{StaticResource AccentBrush}"/>
   <Setter Property="SelectionBrush" Value="{StaticResource NavActiveBrush}"/>
   <Style.Triggers>
    <Trigger Property="IsMouseOver" Value="True">
     <Setter Property="BorderBrush" Value="{StaticResource ControlBorderBrush}"/>
    </Trigger>
    <Trigger Property="IsKeyboardFocusWithin" Value="True">
     <Setter Property="BorderBrush" Value="{StaticResource FocusBrush}"/>
    </Trigger>
    <Trigger Property="IsEnabled" Value="False">
     <Setter Property="Background" Value="{StaticResource DisabledControlBrush}"/>
     <Setter Property="Foreground" Value="{StaticResource DisabledTextBrush}"/>
     <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}"/>
    </Trigger>
   </Style.Triggers>
  </Style>
  <Style x:Key="DetailBox" TargetType="TextBox" BasedOn="{StaticResource {x:Type TextBox}}">
   <Setter Property="IsReadOnly" Value="True"/>
   <Setter Property="Padding" Value="10,6"/>
   <Setter Property="TextWrapping" Value="Wrap"/>
   <Setter Property="HorizontalScrollBarVisibility" Value="Disabled"/>
   <Setter Property="VerticalScrollBarVisibility" Value="Auto"/>
  </Style>
  <Style TargetType="ComboBox">
   <Setter Property="Foreground" Value="{StaticResource TextBrush}"/>
   <Setter Property="Background" Value="{StaticResource ControlBrush}"/>
   <Setter Property="BorderBrush" Value="{StaticResource ControlBorderBrush}"/>
   <Setter Property="BorderThickness" Value="1"/>
   <Setter Property="MinHeight" Value="38"/>
   <Setter Property="MaxDropDownHeight" Value="300"/>
   <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
   <Setter Property="ToolTip">
    <Setter.Value>
     <ToolTip ContentTemplate="{x:Null}">
      <ContentPresenter Content="{Binding PlacementTarget.SelectionBoxItem, RelativeSource={RelativeSource AncestorType=ToolTip}}"
                        ContentTemplate="{Binding PlacementTarget.SelectionBoxItemTemplate, RelativeSource={RelativeSource AncestorType=ToolTip}}"
                        ContentTemplateSelector="{Binding PlacementTarget.ItemTemplateSelector, RelativeSource={RelativeSource AncestorType=ToolTip}}"
                        ContentStringFormat="{Binding PlacementTarget.SelectionBoxItemStringFormat, RelativeSource={RelativeSource AncestorType=ToolTip}}">
       <ContentPresenter.Resources>
        <Style TargetType="TextBlock"><Setter Property="TextWrapping" Value="Wrap"/></Style>
       </ContentPresenter.Resources>
      </ContentPresenter>
     </ToolTip>
    </Setter.Value>
   </Setter>
   <Setter Property="Template">
    <Setter.Value>
     <ControlTemplate TargetType="ComboBox">
      <Border x:Name="ComboFrame" CornerRadius="0" Background="{TemplateBinding Background}"
              BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}">
       <Grid>
        <ToggleButton Focusable="False" ClickMode="Press" Cursor="Hand"
                      IsChecked="{Binding IsDropDownOpen, RelativeSource={RelativeSource TemplatedParent}, Mode=TwoWay}">
         <ToggleButton.Template>
          <ControlTemplate TargetType="ToggleButton">
           <Grid Background="Transparent">
            <Path Data="M 0,0 L 4,4 L 8,0" Stroke="{StaticResource MutedBrush}" StrokeThickness="1.5"
                  HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,12,0"/>
           </Grid>
          </ControlTemplate>
         </ToggleButton.Template>
        </ToggleButton>
        <ContentPresenter x:Name="SelectionContent" Margin="12,8,33,8" VerticalAlignment="Center"
                          ClipToBounds="True" IsHitTestVisible="False"
                          Content="{TemplateBinding SelectionBoxItem}"
                          ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}"
                          ContentTemplateSelector="{TemplateBinding ItemTemplateSelector}"
                          ContentStringFormat="{TemplateBinding SelectionBoxItemStringFormat}">
         <ContentPresenter.Resources>
          <Style TargetType="TextBlock" BasedOn="{StaticResource TrimmedText}"/>
         </ContentPresenter.Resources>
        </ContentPresenter>
        <Popup x:Name="PART_Popup" IsOpen="{TemplateBinding IsDropDownOpen}" Placement="Bottom"
               PlacementTarget="{Binding RelativeSource={RelativeSource TemplatedParent}}"
               AllowsTransparency="True" Focusable="False" PopupAnimation="Fade">
         <Border Background="{StaticResource PanelBrush}" BorderBrush="{StaticResource ControlBorderBrush}"
                 BorderThickness="1" CornerRadius="0" Padding="4"
                 Width="{Binding ActualWidth, RelativeSource={RelativeSource TemplatedParent}}"
                 MaxHeight="{TemplateBinding MaxDropDownHeight}">
          <ScrollViewer CanContentScroll="True" HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
           <ItemsPresenter/>
          </ScrollViewer>
         </Border>
        </Popup>
       </Grid>
      </Border>
      <ControlTemplate.Triggers>
       <Trigger Property="IsMouseOver" Value="True">
        <Setter TargetName="ComboFrame" Property="BorderBrush" Value="{StaticResource AccentBrush}"/>
       </Trigger>
       <Trigger Property="IsDropDownOpen" Value="True">
        <Setter Property="ToolTipService.IsEnabled" Value="False"/>
        <Setter TargetName="ComboFrame" Property="BorderBrush" Value="{StaticResource AccentBrush}"/>
       </Trigger>
       <Trigger Property="IsKeyboardFocusWithin" Value="True">
        <Setter TargetName="ComboFrame" Property="BorderBrush" Value="{StaticResource FocusBrush}"/>
       </Trigger>
       <Trigger Property="IsEnabled" Value="False">
        <Setter TargetName="ComboFrame" Property="Background" Value="{StaticResource DisabledControlBrush}"/>
        <Setter TargetName="ComboFrame" Property="BorderBrush" Value="{StaticResource BorderBrush}"/>
        <Setter TargetName="SelectionContent" Property="TextElement.Foreground" Value="{StaticResource DisabledTextBrush}"/>
       </Trigger>
      </ControlTemplate.Triggers>
     </ControlTemplate>
    </Setter.Value>
   </Setter>
  </Style>
  <Style TargetType="ComboBoxItem">
   <Setter Property="Foreground" Value="{StaticResource TextBrush}"/>
   <Setter Property="Padding" Value="10,8"/>
   <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
   <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
   <Setter Property="Template">
    <Setter.Value>
     <ControlTemplate TargetType="ComboBoxItem">
      <Border x:Name="Option" Background="Transparent" CornerRadius="0" Padding="{TemplateBinding Padding}"
              BorderThickness="1" BorderBrush="Transparent" ClipToBounds="True">
       <ContentPresenter x:Name="OptionContent" HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" VerticalAlignment="Center">
        <ContentPresenter.Resources>
         <Style TargetType="TextBlock" BasedOn="{StaticResource TrimmedText}"/>
        </ContentPresenter.Resources>
       </ContentPresenter>
      </Border>
      <ControlTemplate.Triggers>
       <Trigger Property="IsSelected" Value="True">
        <Setter TargetName="Option" Property="Background" Value="{StaticResource NavActiveBrush}"/>
        <Setter TargetName="OptionContent" Property="TextElement.Foreground" Value="{StaticResource AccentBrush}"/>
       </Trigger>
       <Trigger Property="IsHighlighted" Value="True">
        <Setter TargetName="Option" Property="Background" Value="{StaticResource ControlHoverBrush}"/>
       </Trigger>
       <Trigger Property="IsKeyboardFocused" Value="True">
        <Setter TargetName="Option" Property="BorderBrush" Value="{StaticResource FocusBrush}"/>
       </Trigger>
       <Trigger Property="IsEnabled" Value="False">
        <Setter TargetName="Option" Property="Background" Value="{StaticResource DisabledControlBrush}"/>
        <Setter TargetName="OptionContent" Property="TextElement.Foreground" Value="{StaticResource DisabledTextBrush}"/>
       </Trigger>
      </ControlTemplate.Triggers>
     </ControlTemplate>
    </Setter.Value>
   </Setter>
  </Style>
  <Style TargetType="ListBox"><Setter Property="Background" Value="Transparent"/><Setter Property="Foreground" Value="{StaticResource TextBrush}"/><Setter Property="BorderThickness" Value="0"/><Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Disabled"/></Style>
  <Style TargetType="ListBoxItem"><Setter Property="Padding" Value="12,10"/><Setter Property="Margin" Value="0,2"/><Setter Property="HorizontalContentAlignment" Value="Stretch"/><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ListBoxItem"><Border x:Name="Item" CornerRadius="0" Background="Transparent" Padding="{TemplateBinding Padding}"><ContentPresenter/></Border><ControlTemplate.Triggers><Trigger Property="IsSelected" Value="True"><Setter TargetName="Item" Property="Background" Value="#21423F"/></Trigger><Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Item" Property="Background" Value="#213349"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter></Style>
  <Style TargetType="DataGrid"><Setter Property="Background" Value="{StaticResource PanelBrush}"/><Setter Property="Foreground" Value="{StaticResource TextBrush}"/><Setter Property="BorderThickness" Value="0"/><Setter Property="RowBackground" Value="{StaticResource PanelBrush}"/><Setter Property="AlternatingRowBackground" Value="#142032"/><Setter Property="GridLinesVisibility" Value="None"/><Setter Property="HeadersVisibility" Value="Column"/><Setter Property="AutoGenerateColumns" Value="False"/><Setter Property="IsReadOnly" Value="True"/><Setter Property="CanUserAddRows" Value="False"/><Setter Property="CanUserDeleteRows" Value="False"/><Setter Property="CanUserReorderColumns" Value="False"/><Setter Property="SelectionMode" Value="Single"/><Setter Property="SelectionUnit" Value="FullRow"/><Setter Property="RowHeaderWidth" Value="0"/><Setter Property="RowHeight" Value="40"/><Setter Property="ColumnHeaderHeight" Value="39"/><Setter Property="ClipboardCopyMode" Value="IncludeHeader"/><Setter Property="EnableRowVirtualization" Value="True"/><Setter Property="EnableColumnVirtualization" Value="True"/></Style>
  <Style x:Key="PageGrid" TargetType="DataGrid" BasedOn="{StaticResource {x:Type DataGrid}}">
   <Setter Property="HorizontalScrollBarVisibility" Value="Auto"/>
   <Setter Property="VerticalScrollBarVisibility" Value="Auto"/>
   <Setter Property="MinColumnWidth" Value="72"/>
  </Style>
  <Style TargetType="DataGridColumnHeader"><Setter Property="Foreground" Value="{StaticResource MutedBrush}"/><Setter Property="Background" Value="#18263A"/><Setter Property="BorderThickness" Value="0,0,0,1"/><Setter Property="BorderBrush" Value="{StaticResource BorderBrush}"/><Setter Property="Padding" Value="12,8"/><Setter Property="FontSize" Value="11"/><Setter Property="FontWeight" Value="SemiBold"/></Style>
  <Style TargetType="DataGridCell"><Setter Property="BorderThickness" Value="0"/><Setter Property="Padding" Value="12,5"/><Setter Property="Foreground" Value="{StaticResource TextBrush}"/><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="DataGridCell"><Border Background="{TemplateBinding Background}" Padding="{TemplateBinding Padding}"><ContentPresenter VerticalAlignment="Center"/></Border><ControlTemplate.Triggers><Trigger Property="IsSelected" Value="True"><Setter Property="Background" Value="#214C49"/><Setter Property="Foreground" Value="#F1FFFC"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter></Style>
  <Style x:Key="CellText" TargetType="TextBlock" BasedOn="{StaticResource TrimmedText}"/>
  <Style x:Key="StatusText" TargetType="TextBlock" BasedOn="{StaticResource CellText}">
   <Setter Property="Foreground" Value="{StaticResource MutedBrush}"/>
   <Setter Property="AutomationProperties.ItemStatus" Value="{Binding Status}"/>
   <Style.Triggers>
    <DataTrigger Binding="{Binding Status}" Value="WAITING"><Setter Property="Foreground" Value="{StaticResource MutedBrush}"/></DataTrigger>
    <DataTrigger Binding="{Binding Status}" Value="READING"><Setter Property="Foreground" Value="{StaticResource AccentBrush}"/><Setter Property="FontWeight" Value="SemiBold"/></DataTrigger>
    <DataTrigger Binding="{Binding Status}" Value="READ"><Setter Property="Foreground" Value="{StaticResource AccentBrush}"/></DataTrigger>
    <DataTrigger Binding="{Binding Status}" Value="Reported"><Setter Property="Foreground" Value="{StaticResource AccentBrush}"/></DataTrigger>
    <DataTrigger Binding="{Binding Status}" Value="CHECK"><Setter Property="Foreground" Value="{StaticResource WarningBrush}"/></DataTrigger>
    <DataTrigger Binding="{Binding Status}" Value="NOT READ"><Setter Property="Foreground" Value="{StaticResource WarningBrush}"/></DataTrigger>
    <DataTrigger Binding="{Binding Status}" Value="Stopped"><Setter Property="Foreground" Value="{StaticResource WarningBrush}"/></DataTrigger>
    <DataTrigger Binding="{Binding Status}" Value="Missing"><Setter Property="Foreground" Value="{StaticResource WarningBrush}"/></DataTrigger>
    <DataTrigger Binding="{Binding Status}" Value="Default"><Setter Property="Foreground" Value="{StaticResource WarningBrush}"/></DataTrigger>
   </Style.Triggers>
  </Style>
  <Style x:Key="ScrollThumb" TargetType="Thumb"><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Thumb"><Border x:Name="ThumbBody" Background="#3D526C" CornerRadius="0" Margin="2"/><ControlTemplate.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter TargetName="ThumbBody" Property="Background" Value="#64809E"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter></Style>
  <ControlTemplate x:Key="VerticalScrollbar" TargetType="ScrollBar"><Grid Background="#101A2A"><Track x:Name="PART_Track" Orientation="Vertical" IsDirectionReversed="True" Minimum="{TemplateBinding Minimum}" Maximum="{TemplateBinding Maximum}" Value="{TemplateBinding Value}" ViewportSize="{TemplateBinding ViewportSize}"><Track.DecreaseRepeatButton><RepeatButton Command="ScrollBar.PageUpCommand" Opacity="0" Focusable="False"/></Track.DecreaseRepeatButton><Track.Thumb><Thumb Style="{StaticResource ScrollThumb}"/></Track.Thumb><Track.IncreaseRepeatButton><RepeatButton Command="ScrollBar.PageDownCommand" Opacity="0" Focusable="False"/></Track.IncreaseRepeatButton></Track></Grid></ControlTemplate>
  <ControlTemplate x:Key="HorizontalScrollbar" TargetType="ScrollBar"><Grid Background="#101A2A"><Track x:Name="PART_Track" Orientation="Horizontal" Minimum="{TemplateBinding Minimum}" Maximum="{TemplateBinding Maximum}" Value="{TemplateBinding Value}" ViewportSize="{TemplateBinding ViewportSize}"><Track.DecreaseRepeatButton><RepeatButton Command="ScrollBar.PageLeftCommand" Opacity="0" Focusable="False"/></Track.DecreaseRepeatButton><Track.Thumb><Thumb Style="{StaticResource ScrollThumb}"/></Track.Thumb><Track.IncreaseRepeatButton><RepeatButton Command="ScrollBar.PageRightCommand" Opacity="0" Focusable="False"/></Track.IncreaseRepeatButton></Track></Grid></ControlTemplate>
  <Style TargetType="ScrollBar"><Setter Property="Width" Value="12"/><Setter Property="Template" Value="{StaticResource VerticalScrollbar}"/><Style.Triggers><Trigger Property="Orientation" Value="Horizontal"><Setter Property="Width" Value="Auto"/><Setter Property="Height" Value="12"/><Setter Property="Template" Value="{StaticResource HorizontalScrollbar}"/></Trigger></Style.Triggers></Style>
 </Application.Resources>
</Application>
